<?php

namespace App\Http\Controllers;

use MeaCms\PageSections\Models\Element;
use MeaCms\Partners\Models\Partner;
use MeaCms\Menu\Support\Util;
use MeaCms\PageSections\Services\PageSectionService;
use Illuminate\Http\Request;
use Inertia\Inertia;
use Inertia\Response;

class AboutController extends Controller
{
    public function __invoke(Request $request): Response
    {
        $pageSectionService = app(PageSectionService::class);

        $welcome = Element::where('published', 1)
            ->where('name', 'welcome')->first();
        $welcome = $welcome ? [
            'id' => $welcome->id,
            'name' => $welcome->name,
            'title' => $welcome->title,
            'content' => $welcome->content,
            'type' => $welcome->type,
            'photo' => Util::pictureUrl($welcome->photo),
        ] : null;

        $numbersSection = $pageSectionService->getByPageSectionName(
            'numbers',
            ['elements' => fn ($query) => $query->where('published', 1)],
            true
        );
        $numbers = $numbersSection ? $numbersSection->elements : [];

        $whoWeAre = Element::where('published', 1)
            ->where('name', 'who-we-are')
            ->first();
        $whoWeAre = $whoWeAre ? [
            'id' => $whoWeAre->id,
            'name' => $whoWeAre->name,
            'title' => $whoWeAre->title,
            'content' => $whoWeAre->content,
            'type' => $whoWeAre->type,
            'photo' => Util::pictureUrl($whoWeAre->photo),
        ] : null;

        $partners = Partner::where('published', 1)->get()->map(fn ($item) => [
            'id' => $item->id,
            'title' => $item->title,
            'logo' => Util::pictureUrl($item->logo),
            'website' => $item->website,
            'description' => $item->description,
        ]);

        $coreValuesSection = $pageSectionService->getByPageSectionName(
            'core-values',
            ['elements' => fn ($query) => $query->where('published', 1)],
            true
        );
        $coreValues = $coreValuesSection ? $coreValuesSection->elements : [];

        return Inertia::render('About', [
            'welcome' => $welcome,
            'whoWeAre' => $whoWeAre,
            'partners' => $partners,
            'coreValues' => $coreValues,
            'numbers' => $numbers,
        ]);
    }
}
